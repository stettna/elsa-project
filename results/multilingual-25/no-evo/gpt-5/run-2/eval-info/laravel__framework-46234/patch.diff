+<?php
+require __DIR__.'/vendor/autoload.php';
+
+use Illuminate\Routing\UrlGenerator;
+use Illuminate\Routing\RouteCollection;
+use Illuminate\Http\Request;
+
+$routes = new RouteCollection;
+$request = Request::create('http://localhost/previous-test');
+$generator = new UrlGenerator($routes, $request);
+
+// Case 1: referrer equals current (should use fallback)
+$request->headers->set('referer', 'http://localhost/previous-test');
+echo "Case1: ".$generator->previous('/with-a-fallback').PHP_EOL;
+
+// Case 1b: referrer equals current but with trailing slash and query (should use fallback)
+$request->headers->set('referer', 'http://localhost/previous-test/?foo=1');
+echo "Case1b: ".$generator->previous('/with-a-fallback').PHP_EOL;
+
+// Case 2: referrer different (should return referrer)
+$request->headers->set('referer', 'http://localhost/another-page?foo=1');
+echo "Case2: ".$generator->previous('/with-a-fallback').PHP_EOL;
+
+// Case 3: no referrer, no session, fallback false (should return root)
+$request->headers->remove('referer');
+echo "Case3: ".$generator->previous(false).PHP_EOL;
+
+// Case 4: no referrer, fallback provided (should return fallback)
+echo "Case4: ".$generator->previous('/with-a-fallback').PHP_EOL;
