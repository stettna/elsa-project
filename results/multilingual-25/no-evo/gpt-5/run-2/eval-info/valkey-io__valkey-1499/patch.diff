diff --git a/src/db.c b/src/db.c
index 1362b5f9d..5804f98c7 100644
--- a/src/db.c
+++ b/src/db.c
@@ -124,9 +124,24 @@ robj *lookupKey(serverDb *db, robj *key, int flags) {
         /* Update the access time for the ageing algorithm.
          * Don't do it if we have a saving child, as this will trigger
          * a copy on write madness. */
-        if (server.current_client && server.current_client->flag.no_touch &&
-            server.current_client->cmd->proc != touchCommand)
-            flags |= LOOKUP_NOTOUCH;
+        /* If the client is in no-touch mode, avoid updating access time unless the
+         * currently executing command is TOUCH. When commands are invoked from
+         * scripts or other internal contexts, server.executing_client holds the
+         * actual command being executed, while server.current_client may still
+         * reference the outer command (e.g. EVAL/FCALL). Prefer checking the
+         * executing client's command proc to correctly allow TOUCH inside scripts. */
+        if (server.current_client && server.current_client->flag.no_touch) {
+            struct serverCommand *curcmd = NULL;
+            if (server.executing_client && server.executing_client->cmd) {
+                curcmd = server.executing_client->cmd;
+            } else if (server.current_client->cmd) {
+                curcmd = server.current_client->cmd;
+            }
+            if (!(curcmd && curcmd->proc == touchCommand)) {
+                flags |= LOOKUP_NOTOUCH;
+            }
+        }
+
         if (!hasActiveChildProcess() && !(flags & LOOKUP_NOTOUCH)) {
             /* Shared objects can't be stored in the database. */
             serverAssert(val->refcount != OBJ_SHARED_REFCOUNT);
