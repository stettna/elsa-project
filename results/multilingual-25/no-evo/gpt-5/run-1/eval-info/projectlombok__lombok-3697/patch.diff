+++ b/patch_find_inner_class.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+set -euo pipefail
+file="/testbed/src/core/lombok/javac/handlers/HandleSuperBuilder.java"
+sig1='private JavacNode findInnerClass(JavacNode parent, String name) {'
+sig2='private ListBuffer<JCExpression> getTypeParamExpressions(List<? extends JCTree> typeParams, JavacTreeMaker maker, JavacNode source) {'
+start=$(grep -nF "$sig1" "$file" | head -n1 | cut -d: -f1 || true)
+next=$(grep -nF "$sig2" "$file" | head -n1 | cut -d: -f1 || true)
+if [ -z "${start:-}" ] || [ -z "${next:-}" ] || [ "$start" -ge "$next" ]; then
+  echo "Failed to locate method boundaries. Context around expected area:"
+  nl -ba "$file" | sed -n '1080,1140p'
+  exit 1
+fi
+head -n $((start-1)) "$file" > "$file.head"
+cat > "$file.mid" <<'EOF'
+		private JavacNode findInnerClass(JavacNode parent, String name) {
+			for (JavacNode child : parent.down()) {
+				if (child.getKind() != Kind.TYPE) continue;
+				JCClassDecl td = (JCClassDecl) child.get();
+				if (td.name.contentEquals(name)) return child;
+			}
+			return null;
+		}
+EOF
+tail -n +$next "$file" > "$file.tail"
+cat "$file.head" "$file.mid" "$file.tail" > "$file.new"
+mv "$file.new" "$file"
+rm -f "$file.head" "$file.mid" "$file.tail"
+nl -ba "$file" | sed -n '1088,1126p'
