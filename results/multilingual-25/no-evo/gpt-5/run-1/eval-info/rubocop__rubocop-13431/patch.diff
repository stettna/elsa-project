index b00156373..fbb6a1c01 100644
--- a/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
+++ b/lib/rubocop/cop/layout/empty_lines_around_method_body.rb
@@ -27,7 +27,14 @@ module RuboCop
         KIND = 'method'
 
         def on_def(node)
-          check(node, node.body)
+          # If the method signature spans multiple lines (i.e., parenthesized arguments),
+          # start checking after the last line of the arguments instead of the `def` line.
+          first_line =
+            if node.arguments && node.arguments.loc.begin
+              node.arguments.last_line
+            end
+
+          check(node, node.body, adjusted_first_line: first_line)
         end
         alias on_defs on_def
 
