+def inspect_source(source)
+  processed_source = RuboCop::ProcessedSource.new(source, 3.2)
+  config = RuboCop::Config.new({
+    'Layout/EmptyLinesAroundMethodBody' => { 'Enabled' => true }
+  }, 'fake.yml')
+  registry = RuboCop::Cop::Registry.new([RuboCop::Cop::Layout::EmptyLinesAroundMethodBody.new])
+  team = RuboCop::Cop::Team.new(registry, config, raise_error: true)
+  offenses = team.inspect_processed_source(processed_source)
+  offenses.map { |o| [o.message, o.location.line] }
+end
