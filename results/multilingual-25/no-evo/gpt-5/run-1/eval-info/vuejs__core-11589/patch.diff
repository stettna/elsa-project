+
+const { ref, computed } = reactivity
+const { watch } = runtimeCore
+
+function test(label, sourceFactory) {
+  const results = []
+  const src = sourceFactory()
+  for (let i = 0; i < 5; i++) {
+    watch(src, (v) => {
+      results.push(i)
+    }, { flush: 'sync' })
+  }
+  // trigger
+  if ('value' in src) {
+    src.value++
+  } else if (typeof src === 'function') {
+    // for getter source
+    // mutate the underlying ref used by getter
+    // handled in specific test
+  }
+  return results
+}
+
+// Test 1: ref
+const r = ref(0)
+const orderRef = []
+for (let i = 0; i < 5; i++) {
+  watch(r, () => orderRef.push(i), { flush: 'sync' })
+}
+r.value++
+console.log('ref sync watchers order:', orderRef.join(', '))
+
+// Test 2: computed based on same ref
+const c = computed(() => r.value)
+const orderComp = []
+for (let i = 0; i < 5; i++) {
+  watch(c, () => orderComp.push(i), { flush: 'sync' })
+}
+r.value++
+console.log('computed sync watchers order:', orderComp.join(', '))
