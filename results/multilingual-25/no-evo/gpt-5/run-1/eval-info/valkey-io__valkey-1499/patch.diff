diff --git a/src/expire.c b/src/expire.c
index e4c3b0ec9..825c7c84c 100644
--- a/src/expire.c
+++ b/src/expire.c
@@ -781,7 +781,16 @@ void persistCommand(client *c) {
 /* TOUCH key1 [key2 key3 ... keyN] */
 void touchCommand(client *c) {
     int touched = 0;
-    for (int j = 1; j < c->argc; j++)
+    /* In no-touch client mode, normal lookups won't update access time.
+     * However, TOUCH must always update the last access time even when
+     * invoked from scripts or when the client is in no-touch mode.
+     * Temporarily disable the client's no_touch flag so that lookups
+     * performed by TOUCH will update LRU/LFU/access time. */
+    uint64_t saved_no_touch = c->flag.no_touch;
+    c->flag.no_touch = 0;
+    for (int j = 1; j < c->argc; j++) {
         if (lookupKeyRead(c->db, c->argv[j]) != NULL) touched++;
+    }
+    c->flag.no_touch = saved_no_touch;
     addReplyLongLong(c, touched);
 }
