+<?php
+require __DIR__.'/vendor/autoload.php';
+
+use Illuminate\Http\Request;
+use Illuminate\Routing\UrlGenerator;
+use Illuminate\Routing\RouteCollection;
+
+function test_case($label, $currentUrl, $referer, $fallback) {
+    $request = Request::create($currentUrl);
+    if ($referer !== null) {
+        $request->headers->set('referer', $referer);
+    }
+    $url = new UrlGenerator(new RouteCollection, $request);
+    $result = $url->previous($fallback);
+    echo $label, ": ", $result, PHP_EOL;
+}
+
+test_case(
+    "Case 1 (referer equals current; expect fallback absolute URL)",
+    'http://localhost/previous-test',
+    'http://localhost/previous-test?x=1',
+    '/with-a-fallback'
+);
+
+test_case(
+    "Case 2 (referer different; expect referer)",
+    'http://localhost/previous-test',
+    'http://localhost/another',
+    '/with-a-fallback'
+);
+
+test_case(
+    "Case 3 (no referer; expect fallback absolute URL)",
+    'http://localhost/previous-test',
+    null,
+    '/with-a-fallback'
+);
+
+test_case(
+    "Case 4 (no referer or fallback; expect root)",
+    'http://localhost/previous-test',
+    null,
+    false
+);
