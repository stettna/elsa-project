             next if and_with_rhs_or?(node)
+            max = safe_navigation_chain_length_max
+            next if max && chain_length_after_correction(rhs_receiver, rhs) > max
 
             removal_ranges.each { |range| corrector.remove(range) }
             yield corrector if block_given?
@@ -371,6 +373,22 @@ module RuboCop
