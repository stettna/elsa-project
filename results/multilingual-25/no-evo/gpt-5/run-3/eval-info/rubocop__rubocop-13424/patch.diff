+        def chain_length_after_correction(start_method, method_chain)
+          length = 0
+          start_method.each_ancestor do |ancestor|
+            break unless %i[send csend block].include?(ancestor.type)
+            length += 1 if ancestor.send_type? || ancestor.csend_type?
+            break if ancestor == method_chain
+          end
+          length
+        end
