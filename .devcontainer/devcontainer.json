{
	"name": "elsa-project",
	"build": { 
		"context": "..",
		"dockerfile": "../ollama/Dockerfile",
		"args": {
			"NODE_VERSION": "none"
		}
	},
	"forwardPorts": [11434],
	"mounts": [
		//"source=/nfs/semeru/gates,target=/workspaces/gates/data,type=bind,consistency=cached",
	],
	"remoteEnv": {
        "MY_PROJECT_NAME": "elsa-project"
    },
	"runArgs": ["--gpus", "all", "-e", "GRANT_SUDO=yes","--name", "${localWorkspaceFolderBasename}-nstettler", "--add-host=host.docker.internal:host-gateway", "--network=devnet", "-p", "11435:11434"]	
}
